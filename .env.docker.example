# Copy to .env.docker and fill in real values, then:
#   docker compose --env-file .env.docker up --build
#
# Never commit .env.docker with real secrets. Unlike .env (used by
# `npm run dev` directly against a locally-installed Postgres/Redis), this
# file feeds docker-compose.yml, which builds DATABASE_URL/REDIS_URL itself
# from the pieces below — don't set those two directly here.

# --- Postgres (the `postgres` service in docker-compose.yml) ---
POSTGRES_USER="instamate"
POSTGRES_PASSWORD=""
POSTGRES_DB="instamate"
# Host port Postgres is published on (only needed for prisma:migrate /
# prisma:seed / prisma:studio run from the host — see docs/DEPLOYMENT.md).
POSTGRES_PORT="5432"

# --- Redis (the `redis` service in docker-compose.yml) ---
REDIS_PORT="6379"

# --- App ---
APP_PORT="3000"

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
NEXTAUTH_SECRET=""
# Must be the real public URL of your deployment (https:// in production —
# Auth.js and the Instagram OAuth state cookie both key "secure cookie"
# behavior off this).
NEXTAUTH_URL="http://localhost:3000"

EMAIL_SERVER=""
EMAIL_FROM="InstaMate AI <noreply@example.com>"

# --- Meta / Instagram Graph API ---
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v26.0"
META_WEBHOOK_VERIFY_TOKEN="insta_chat_meta_webhook_9f82kLm72xQp"

# --- Google Gemini ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# --- Security ---
# 32+ character random string. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
