# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instamate?schema=public"

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Email magic-link provider. Leave both empty in local dev: the sign-in link
# is logged to the server console instead of being sent. Set both to enable
# real email delivery (e.g. via an SMTP relay or Resend's SMTP endpoint).
EMAIL_SERVER=""
EMAIL_FROM="InstaMate AI <noreply@example.com>"

# --- SocialAPI.AI Instagram integration (switched from Meta Graph API 2026-09-21) ---
# Get your API key at https://social-api.ai
SOCIALAPI_TOKEN=""
# Returned once by `POST /webhooks` when you first register the webhook
# endpoint — see docs/INSTAGRAM_SETUP.md for the one-time setup call.
SOCIALAPI_WEBHOOK_SECRET=""

# --- Google Gemini (wired up in Phase 7) ---
GEMINI_API_KEY=""
# gemini-3.8-flash was the current stable default as of 2026-09-17 — see
# docs/GEMINI_SETUP.md. Gemini model names change often; re-verify before
# assuming this is still current.
GEMINI_MODEL="gemini-3.8-flash"
